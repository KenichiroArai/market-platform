# Normalize line endings to LF for text files (stable diffs on GitHub / cross-OS)
* text=auto eol=lf

# Explicitly treat common source and config as text with LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.* text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.prettierignore text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
Makefile text eol=lf

# Lockfiles: keep as text for readable diffs
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Windows batch scripts may require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.wasm binary
