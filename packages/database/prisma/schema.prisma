// Prisma schema（Phase 2: 銘柄マスタ・日足価格を追加）
//
// Client は packages/database/generated に出力する（node_modules へは出さない）。
// DATABASE_URL は prisma.config.ts 側で渡す（Prisma 7 の構成）。

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// 上場市場。Yahoo Finance のティッカー規約（US は素のティッカー、JP は `.T` 接尾辞）と対応する。
enum Market {
  US
  JP
}

/// 認証ユーザー。パスワードは bcrypt ハッシュのみ保存する（平文は永続化しない）。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

/// 銘柄マスタ。価格取得ジョブの対象は isActive=true の行。
/// ticker は Yahoo Finance 形式（例: AAPL / 7203.T）をそのまま保持する。
model Symbol {
  id        String   @id @default(cuid())
  ticker    String
  market    Market
  name      String
  currency  String
  exchange  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyPrices DailyPrice[]

  @@unique([ticker, market])
  @@index([market])
}

/// 日足 OHLC。symbolId + date で一意にし、同期ジョブは upsert する。
model DailyPrice {
  id        String   @id @default(cuid())
  symbolId  String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, date])
  @@index([date])
}
