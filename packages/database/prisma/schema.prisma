// Prisma schema（User / Symbol / DailyPrice / Watchlist / Portfolio / IndicatorSet）
//
// Client は packages/database/generated に出力する（node_modules へは出さない）。
// DATABASE_URL は prisma.config.ts 側で渡す（Prisma 7 の構成）。

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// 上場市場。Yahoo Finance のティッカー規約（US は素のティッカー、JP は `.T` 接尾辞）と対応する。
enum Market {
  US
  JP
}

/// 認証ユーザー。パスワードは bcrypt ハッシュのみ保存する（平文は永続化しない）。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchlists Watchlist[]
  portfolios Portfolio[]
  signalDefinitions SignalDefinition[]
  backtestRuns      BacktestRun[]
  indicatorSets     IndicatorSet[]

  @@index([email])
}

/// 銘柄マスタ。価格取得ジョブの対象は isActive=true の行。
/// ticker は Yahoo Finance 形式（例: AAPL / 7203.T）をそのまま保持する。
model Symbol {
  id        String   @id @default(cuid())
  ticker    String
  market    Market
  name      String
  currency  String
  exchange  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyPrices       DailyPrice[]
  watchlistItems    WatchlistItem[]
  portfolioHoldings PortfolioHolding[]
  backtestTrades    BacktestTrade[]

  @@unique([ticker, market])
  @@index([market])
}

/// サポートするシグナル戦略の種類。実装は analysis 側のレジストリで分岐する。
enum SignalStrategyType {
  SMA_CROSS
  RSI_THRESHOLD
  MACD_CROSS
  /// チャート同系トレンドスコアの閾値クロス（ADR 012）
  TREND_SCORE_THRESHOLD
}

/// 売買シグナル（約定方向）。ロング限定のため BUY / SELL のみ扱う。
enum TradeSide {
  BUY
  SELL
}

/// 日足 OHLC。symbolId + date で一意にし、同期ジョブは upsert する。
model DailyPrice {
  id        String   @id @default(cuid())
  symbolId  String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, date])
  @@index([date])
}

/// ユーザー所有の名前付きウォッチリスト。1 ユーザーが複数持てる。
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

/// ウォッチリスト内の銘柄参照。同一リスト内で symbol は一意。
model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  symbolId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbolId])
  @@index([symbolId])
}

/// ユーザー所有の名前付きポートフォリオ。1 ユーザーが複数持てる。
model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings PortfolioHolding[]

  @@index([userId])
}

/// ポートフォリオ内の保有。quantity と平均取得単価 averageCost で評価・損益を算出する。
model PortfolioHolding {
  id          String  @id @default(cuid())
  portfolioId String
  symbolId    String
  quantity    Decimal @db.Decimal(18, 6)
  averageCost Decimal @db.Decimal(18, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbolId])
  @@index([symbolId])
}

/// チャート分析の指標トグル集合。カタログ ID・パラメータ上書き・スコア設定を持ち、計算結果は保存しない（ADR 014）。
model IndicatorSet {
  id              String   @id @default(cuid())
  userId          String
  name            String
  indicatorIds    String[]
  /// カタログ ID ごとのパラメータ上書き（差分のみ）。例: { "sma25": { "period": 30 } }
  indicatorParams Json     @default("{}")
  /// 6 グループ配点。null は ADR 007 既定（40/20/10/10/10/10）
  groupWeights    Json?
  /// トレンドスコア買い閾値。null は 37.5
  buyThreshold    Float?
  /// トレンドスコア売り閾値。null は -42.5
  sellThreshold   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  backtestRuns BacktestRun[]

  @@unique([userId, name])
  @@index([userId])
}

/// ユーザーが作成するシグナル戦略定義。paramsJson は戦略ごとの可変パラメータ。
model SignalDefinition {
  id           String             @id @default(cuid())
  userId       String
  name         String
  description  String?
  strategyType SignalStrategyType
  paramsJson   Json
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  backtestRuns BacktestRun[]

  @@index([userId])
  @@index([strategyType])
  @@unique([userId, name])
}

/// バックテスト実行のヘッダー。期間・コスト設定・集計値を保持する。
model BacktestRun {
  id                 String              @id @default(cuid())
  userId             String
  /// 新規実行の起点。過去ラン互換のため null 可。
  indicatorSetId     String?
  /// 過去ラン互換。新規は null。
  signalDefinitionId String?
  /// 実行時に resolveSignalRule した戦略のスナップショット
  strategyType       SignalStrategyType
  paramsJson         Json
  symbolId           String
  fromDate           DateTime            @db.Date
  toDate             DateTime            @db.Date
  initialCash        Decimal             @db.Decimal(18, 6)
  feeRate            Decimal             @db.Decimal(12, 6)
  slippageRate       Decimal             @db.Decimal(12, 6)
  finalEquity        Decimal             @db.Decimal(18, 6)
  totalReturnRate    Decimal             @db.Decimal(12, 6)
  maxDrawdownRate    Decimal             @db.Decimal(12, 6)
  totalTrades        Int
  winRate            Decimal             @db.Decimal(12, 6)
  /// 年率シャープ（リスクフリー 0）
  sharpeRatio        Decimal             @db.Decimal(18, 6) @default(0)
  /// プロフィットファクター
  profitFactor       Decimal             @db.Decimal(18, 6) @default(0)
  /// Buy & Hold リターン率
  buyHoldReturnRate  Decimal             @db.Decimal(12, 6) @default(0)
  /// Buy & Hold 最終資産
  buyHoldFinalEquity Decimal             @db.Decimal(18, 6) @default(0)
  /// 論理削除。false の run は一覧デフォルトから除外する。
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicatorSet     IndicatorSet?     @relation(fields: [indicatorSetId], references: [id], onDelete: SetNull)
  signalDefinition SignalDefinition? @relation(fields: [signalDefinitionId], references: [id], onDelete: SetNull)
  trades           BacktestTrade[]
  equityPoints     BacktestEquityPoint[]

  @@index([userId, createdAt])
  @@index([userId, isActive, createdAt])
  @@index([indicatorSetId])
  @@index([signalDefinitionId])
  @@index([symbolId])
}

/// バックテスト内の約定ログ。1 行が 1 取引（entry+exit）を表す。
model BacktestTrade {
  id             String   @id @default(cuid())
  backtestRunId  String
  symbolId       String
  entryDate      DateTime @db.Date
  exitDate       DateTime @db.Date
  entryPrice     Decimal  @db.Decimal(18, 6)
  exitPrice      Decimal  @db.Decimal(18, 6)
  quantity       Decimal  @db.Decimal(18, 6)
  side           TradeSide
  grossPnl       Decimal  @db.Decimal(18, 6)
  feeAmount      Decimal  @db.Decimal(18, 6)
  slippageAmount Decimal  @db.Decimal(18, 6)
  netPnl         Decimal  @db.Decimal(18, 6)
  /// 買い判断コード（例: sma_golden_cross）。既存行は null。
  entryReason    String?
  /// 売り判断コード（例: sma_dead_cross / force_close_end）。既存行は null。
  exitReason     String?
  /// 買い判断スコア（例: RSI 値）。スコア非採用・既存行は null。
  entryScore     Decimal? @db.Decimal(18, 6)
  /// 売り判断スコア（例: RSI 値）。スコア非採用・既存行は null。
  exitScore      Decimal? @db.Decimal(18, 6)
  /// 買い時点のトレンドスコア内訳（groups + indicators）。既存行は null。
  entryScoreBreakdown Json?
  /// 売り時点のトレンドスコア内訳。強制決済・既存行は null。
  exitScoreBreakdown  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)
  symbol      Symbol      @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([backtestRunId, entryDate])
  @@index([symbolId])
}

/// エクイティカーブの時系列点。描画と最大ドローダウン検証に使う。
model BacktestEquityPoint {
  id            String   @id @default(cuid())
  backtestRunId String
  date          DateTime @db.Date
  cash          Decimal  @db.Decimal(18, 6)
  positionValue Decimal  @db.Decimal(18, 6)
  equity        Decimal  @db.Decimal(18, 6)
  drawdownRate  Decimal  @db.Decimal(12, 6)
  /// その日の判断スコア（RSI / 総合トレンド）。非スコア・既存は null。
  decisionScore Decimal? @db.Decimal(18, 6)
  /// その日のトレンドスコア内訳。RSI/非トレンド・既存は null。
  scoreBreakdown Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)

  @@unique([backtestRunId, date])
  @@index([date])
}
