// Prisma schema（Phase 3: ウォッチリスト・ポートフォリオを追加）
//
// Client は packages/database/generated に出力する（node_modules へは出さない）。
// DATABASE_URL は prisma.config.ts 側で渡す（Prisma 7 の構成）。

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// 上場市場。Yahoo Finance のティッカー規約（US は素のティッカー、JP は `.T` 接尾辞）と対応する。
enum Market {
  US
  JP
}

/// 認証ユーザー。パスワードは bcrypt ハッシュのみ保存する（平文は永続化しない）。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchlists Watchlist[]
  portfolios Portfolio[]

  @@index([email])
}

/// 銘柄マスタ。価格取得ジョブの対象は isActive=true の行。
/// ticker は Yahoo Finance 形式（例: AAPL / 7203.T）をそのまま保持する。
model Symbol {
  id        String   @id @default(cuid())
  ticker    String
  market    Market
  name      String
  currency  String
  exchange  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyPrices       DailyPrice[]
  watchlistItems    WatchlistItem[]
  portfolioHoldings PortfolioHolding[]

  @@unique([ticker, market])
  @@index([market])
}

/// 日足 OHLC。symbolId + date で一意にし、同期ジョブは upsert する。
model DailyPrice {
  id        String   @id @default(cuid())
  symbolId  String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, date])
  @@index([date])
}

/// ユーザー所有の名前付きウォッチリスト。1 ユーザーが複数持てる。
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

/// ウォッチリスト内の銘柄参照。同一リスト内で symbol は一意。
model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  symbolId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbolId])
  @@index([symbolId])
}

/// ユーザー所有の名前付きポートフォリオ。1 ユーザーが複数持てる。
model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings PortfolioHolding[]

  @@index([userId])
}

/// ポートフォリオ内の保有。quantity と平均取得単価 averageCost で評価・損益を算出する。
model PortfolioHolding {
  id          String  @id @default(cuid())
  portfolioId String
  symbolId    String
  quantity    Decimal @db.Decimal(18, 6)
  averageCost Decimal @db.Decimal(18, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbolId])
  @@index([symbolId])
}
