{
  "name": "@market/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @market/database\"",
    "test": "jest --coverage --coverageReporters=text --coverageReporters=text-summary"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.15.4",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.spec.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts"],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
