{
  "name": "market-platform",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@market/web --filter=@market/api --filter=@market/analysis",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@market/api --filter=@market/web --filter=@market/shared-types --filter=@market/database --filter=@market/analysis",
    "test:coverage": "pnpm test",
    "generate": "turbo run generate",
    "db:generate": "pnpm --filter @market/database generate",
    "db:migrate": "pnpm --filter @market/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @market/database migrate:deploy",
    "db:seed": "pnpm --filter @market/database seed",
    "db:studio": "pnpm --filter @market/database studio",
    "docker:up": "node scripts/docker-compose-up.mjs",
    "docker:up:detach": "node scripts/docker-compose-up.mjs -d",
    "docker:down": "docker compose down",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
