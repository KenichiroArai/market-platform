# PostgreSQL
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market
POSTGRES_PORT=5432

# Prisma / NestJS
DATABASE_URL=postgresql://market:market@localhost:5432/market?schema=public

# apps/api
API_PORT=3001
ANALYSIS_URL=http://localhost:8000
# JWT（必須。未設定時は API 起動失敗）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# ログレベル（省略時は Nest 既定）
# LOG_LEVEL=log

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# apps/analysis
ANALYSIS_PORT=8000
