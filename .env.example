# PostgreSQL
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market
POSTGRES_PORT=5432

# Prisma / NestJS
DATABASE_URL=postgresql://market:market@localhost:5432/market?schema=public

# apps/api
API_PORT=3001
ANALYSIS_URL=http://localhost:8000
# JWT（必須。未設定時は API 起動失敗）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# ログレベル（省略時は Nest 既定）
# LOG_LEVEL=log
# 市場データ（Phase 2）
# yahoo | stub（未設定時は yahoo）
MARKET_DATA_PROVIDER=yahoo
# 日次同期 cron（UTC、未設定時は 0 6 * * *）
MARKET_DATA_CRON=0 6 * * *
# 手動/定期同期の既定取得日数（未設定時は 30）
MARKET_DATA_LOOKBACK_DAYS=30

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# apps/analysis
ANALYSIS_PORT=8000
