{
  "name": "@market/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "echo \"No lint configured for @market/web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage --coverageReporters=text --coverageReporters=text-summary"
  },
  "dependencies": {
    "@market/shared-types": "workspace:*",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.2.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@market/shared-types$": "<rootDir>/../../packages/shared-types/dist/index.js",
      "^next/navigation$": "<rootDir>/test/mocks/next-navigation.ts",
      "^next/link$": "<rootDir>/test/mocks/next-link.tsx",
      "^lightweight-charts$": "<rootDir>/test/mocks/lightweight-charts.ts"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!next-env.d.ts",
      "!next.config.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
