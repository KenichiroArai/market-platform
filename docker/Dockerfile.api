# syntax=docker/dockerfile:1
# NestJS API 用イメージ。
# Prisma 7 のエンジンが OpenSSL を必要とするため、slim イメージに openssl を追加する。

FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.9 --activate

# ワークスペース全体をコピーしてから install（filter だけだと解決漏れが起きやすい）
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json .npmrc ./
COPY packages ./packages
COPY apps ./apps

RUN echo ">>> [api] 依存関係をインストール中..." \
  && pnpm install --frozen-lockfile \
  && echo ">>> [api] 依存関係のインストール完了"

# generate 時に参照されるダミー URL（実行時は compose の環境変数で上書き）
ARG DATABASE_URL=postgresql://market:market@postgres:5432/market?schema=public
ENV DATABASE_URL=$DATABASE_URL

RUN echo ">>> [api] shared-types / database / api をビルド中..." \
  && pnpm --filter @market/shared-types build \
  && pnpm --filter @market/database generate \
  && pnpm --filter @market/database build \
  && pnpm --filter @market/api build \
  && echo ">>> [api] ビルド完了"

COPY docker/entrypoint-api.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV NODE_ENV=production
ENV API_PORT=3001
EXPOSE 3001

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
