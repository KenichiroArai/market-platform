# syntax=docker/dockerfile:1
# FastAPI analysis 用イメージ。
# 依存解決は uv（公式イメージからバイナリのみコピー）に任せる。

FROM python:3.12-slim-bookworm

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY apps/analysis/pyproject.toml ./
COPY apps/analysis/app ./app

# ロックが無くても sync で仮想環境を作る（Phase 0）
RUN echo ">>> [analysis] Python 依存関係をインストール中..." \
  && uv sync \
  && echo ">>> [analysis] 依存関係のインストール完了"

COPY docker/entrypoint-analysis.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
